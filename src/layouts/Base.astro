---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL('https://onlinegraphpaper.org');
const canonical = new URL(Astro.url.pathname, site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#2563eb" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <slot name="jsonld" />
    <style is:global>
      :root {
        --bg: #f8fafc;
        --surface: #ffffff;
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #475569;
        --faint: #64748b;
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: #eff6ff;
        --ring: #bfdbfe;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.6;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em; margin: .25rem 0 .75rem; }
      h2 { font-size: 1.45rem; font-weight: 700; letter-spacing: -0.01em; margin: 3rem 0 .75rem; }
      h3 { font-size: 1.02rem; font-weight: 650; }
      p { color: var(--muted); }
      .lead { font-size: 1.15rem; max-width: 760px; }
      strong { color: var(--text); }
      a { color: var(--primary); text-decoration: none; }
      a:hover { color: var(--primary-dark); }

      .site-nav { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
      .site-nav nav { max-width: 1080px; margin: 0 auto; padding: .7rem 1.25rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
      .brand { font-weight: 800; font-size: 1.05rem; color: var(--text); text-decoration: none; letter-spacing: -0.01em; }
      .nav-links { display: flex; gap: 1.1rem; flex-wrap: wrap; }
      .nav-links a { color: var(--muted); font-size: .9rem; font-weight: 500; }
      .nav-links a:hover { color: var(--primary); }

      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 1px 2px rgba(15,23,42,.05);
        transition: box-shadow .15s ease, transform .15s ease, border-color .15s ease;
      }
      .card:hover { border-color: var(--ring); box-shadow: 0 10px 28px rgba(37,99,235,.16); transform: translateY(-3px); }
      .card h3 { margin: 0 0 .3rem; font-size: 1rem; }
      .card p { margin: 0 0 .6rem; font-size: .88rem; color: var(--faint); }
      .card small { display: block; color: var(--faint); font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin-bottom: .3rem; }
      a.card { color: inherit; text-decoration: none; }
      a.card:hover { color: inherit; }

      .btn, .btn-outline {
        display: inline-block;
        padding: .5rem .9rem;
        border-radius: 9px;
        font-size: .88rem;
        font-weight: 600;
        line-height: 1.3;
        text-decoration: none;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease, color .15s ease, transform .15s ease;
        margin: 0 .5rem .5rem 0;
      }
      .btn { background: var(--primary); border: 1px solid var(--primary); color: #fff; }
      .btn:hover { background: var(--primary-dark); border-color: var(--primary-dark); color: #fff; transform: translateY(-1px); }
      .btn-outline { background: var(--surface); border: 1px solid var(--primary); color: var(--primary); }
      .btn-outline:hover { background: var(--primary-soft); color: var(--primary-dark); transform: translateY(-1px); }
      .controls .btn, .controls .btn-outline { margin: 0; }

      .tool { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem; box-shadow: 0 1px 3px rgba(15,23,42,.06); }
      .tool svg { width: 100%; height: auto; max-height: 72vh; border: 1px solid var(--border); border-radius: 8px; background: #fff; touch-action: none; display: block; }
      .controls { display: flex; gap: .75rem; flex-wrap: wrap; align-items: flex-end; margin: .25rem 0 .9rem; }
      .controls label { display: flex; flex-direction: column; gap: .3rem; font-size: .78rem; font-weight: 600; color: var(--faint); }
      .controls select, .controls button {
        padding: .45rem .6rem; border: 1px solid var(--border); border-radius: 8px;
        background: #fff; color: var(--text); font-size: .9rem; font-family: inherit;
      }
      .controls button { cursor: pointer; background: var(--primary-soft); color: var(--primary); border-color: var(--ring); font-weight: 600; }
      .controls button:hover { background: #dbeafe; }

      .gen { display: grid; grid-template-columns: minmax(320px, 400px) 1fr; gap: 1.25rem; align-items: start; margin-top: 1.5rem; }
      @media (max-width: 860px) { .gen { grid-template-columns: 1fr; } }
      .gen-steps { display: flex; flex-direction: column; gap: .9rem; }
      .step { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.05rem 1.05rem .85rem; }
      .step-num { display: block; font-size: .7rem; font-weight: 800; color: var(--primary); letter-spacing: .06em; text-transform: uppercase; }
      .step h3 { margin: .25rem 0 .35rem; font-size: 1rem; }
      .step > p { font-size: .86rem; margin: 0 0 .6rem; }
      .step label { display: block; font-size: .78rem; font-weight: 600; color: var(--faint); margin: .2rem 0 .35rem; }
      .step select { width: 100%; padding: .5rem .6rem; border: 1px solid var(--border); border-radius: 8px; background: #fff; color: var(--text); font-size: .9rem; font-family: inherit; }
      .step ul { list-style: none; padding: 0; margin: 0; }
      .step ul li { margin: .3rem 0; }
      .step ul li a { font-size: .88rem; }
      .preview svg { width: 100%; height: auto; max-height: 75vh; border: 1px solid var(--border); border-radius: 12px; background: #fff; display: block; box-shadow: 0 1px 3px rgba(15,23,42,.06); }
      .tpl-thumb { aspect-ratio: 210/297; margin: -1rem -1rem .6rem; border-radius: 11px 11px 0 0; overflow: hidden; background: #fff; border-bottom: 1px solid var(--border); display: block; }
      .tpl-thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
      .card h3 a { color: var(--text); }
      .card h3 a:hover { color: var(--primary); }

      .tags { display: flex; gap: .3rem; flex-wrap: wrap; margin-top: .35rem; }
      .tags span { font-size: .68rem; color: var(--faint); background: #f1f5f9; border: 1px solid var(--border); border-radius: 999px; padding: .12rem .5rem; }
      .thumb { display: block; width: 100%; aspect-ratio: 210/297; object-fit: cover; margin: -1rem -1rem .6rem; border-radius: 11px 11px 0 0; background: #fff; border-bottom: 1px solid var(--border); }

      .faq-item { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: .9rem 1rem; margin-bottom: .6rem; }
      .faq-item h3 { margin: 0 0 .3rem; font-size: .98rem; }
      .faq-item p { margin: 0; font-size: .9rem; }

      details { border: 1px solid var(--border); border-radius: 10px; margin-bottom: .75rem; background: var(--surface); }
      summary { cursor: pointer; padding: .8rem .9rem; font-weight: 600; }
      details .cards { padding: .9rem; }
      nav.more ul { list-style: none; padding: 0; display: flex; gap: 1rem; flex-wrap: wrap; }
      ol { color: var(--muted); padding-left: 1.25rem; }
      ol li { margin-bottom: .6rem; }

      footer { margin-top: 4rem; background: #0f172a; color: #cbd5e1; border-radius: 14px; padding: 2rem 1.25rem; }
      footer p { color: #94a3b8; }
      footer h2 { color: #f1f5f9; font-size: .92rem; text-transform: uppercase; letter-spacing: .04em; margin: 0 0 .7rem; }
      footer ul { list-style: none; padding: 0; margin: 0; }
      footer li { margin: .4rem 0; }
      footer a { color: #cbd5e1; }
      footer a:hover { color: #fff; }
      footer .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1.75rem; }
    </style>
  </head>
  <body>
    <header class="site-nav">
      <nav aria-label="Main navigation">
        <a class="brand" href="/">Online Graph Paper</a>
        <div class="nav-links">
          <a href="/printable-graph-paper/">Printable Graph Paper</a>
          <a href="/square-grid/">Square Grid</a>
          <a href="/isometric-grid/">Isometric Grid</a>
          <a href="/semi-log-graph-paper/">Semi-Log Graph Paper</a>
        </div>
      </nav>
    </header>
    <slot />
  </body>
</html>
