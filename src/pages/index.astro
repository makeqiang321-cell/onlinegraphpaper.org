---
import Base from '../layouts/Base.astro';
import { paperCatalog } from '../content/paperCatalog';
import { paperGroups } from '../content/paperGroups';

const title = 'Online Graph Paper Generator — Free PDF, PNG & SVG';
const description =
  'Free online graph paper generator. Draw on graph paper in your browser, then download print-ready PDF, PNG or SVG in A4, Letter, A3 and Legal.';

const faq = [
  {
    q: 'What is an online graph paper generator?',
    a: 'An online graph paper generator is a browser tool that draws a grid you can download and print. You pick the paper size and spacing, sketch on the grid if you need to, and export a print-ready PDF, PNG, or SVG — no install, no signup, and no watermark.',
  },
  {
    q: 'Can I download graph paper as a PDF?',
    a: 'Yes. Set the paper size and spacing you want, then choose Download PDF. The file is print-ready, so a 5 mm grid stays 5 mm when you print it at 100% scale.',
  },
  {
    q: 'Is this graph paper free?',
    a: 'Yes. Every size, spacing, and format is free, with no watermark, no login, and no download limit. Use it for school, work, or commercial projects at no cost.',
  },
  {
    q: 'How big are the squares on graph paper?',
    a: 'You choose the square size from six spacings, from 2 mm up to 1 inch. A 5 mm square is the common choice for school work, and a 1/4 inch square (about 6.35 mm) matches US letter notebooks.',
  },
  {
    q: 'How do I print graph paper at the correct size?',
    a: 'In the print dialog, set the scale to Actual size or 100% and turn off Fit to page. That prints a 5 mm square at 5 mm; Fit to page shrinks it to about 4.6 mm.',
  },
  {
    q: 'Is quad ruled paper the same as graph paper?',
    a: 'They are close, but not identical. Quad ruled paper is graph paper with four squares per inch, while graph paper can use any spacing. Every quad ruled sheet is graph paper, but not every graph paper sheet is quad ruled.',
  },
  {
    q: 'Which graph paper template should I choose?',
    a: 'Pick by the task: a coordinate plane for plotting, an isometric grid for 3D sketches, or a plain square grid for arithmetic and notes. Each one opens in the same graph paper tool, so your size and spacing stay put.',
  },
  {
    q: 'Can I change the size, spacing, and color?',
    a: 'Yes. Change the paper size, the spacing between lines, and the grid color — blue, gray, or green — before you export. The preview updates as you change each one.',
  },
  {
    q: 'Can I use the online graph paper generator without signing up?',
    a: 'Yes. There is no account to create and nothing to install. Open the page, draw, and download; the generator never asks for an email address.',
  },
  {
    q: 'Does the online graph paper generator work on a phone?',
    a: 'Yes. It runs in a browser, so it works on a phone, tablet, or desktop at any screen width, and the drawing tools respond to touch as well as a mouse.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Online Graph Paper Generator',
    url: 'https://onlinegraphpaper.org/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://onlinegraphpaper.org/' },
    ],
  },
  {
    '@type': 'Organization',
    name: 'Online Graph Paper',
    url: 'https://onlinegraphpaper.org/',
    logo: { '@type': 'ImageObject', url: 'https://onlinegraphpaper.org/apple-touch-icon.png' },
  },
  {
    '@type': 'WebSite',
    name: 'Online Graph Paper',
    url: 'https://onlinegraphpaper.org/',
  },
];

const axesModes = [
  {
    mode: 'Graph paper with axes',
    desc: 'two labeled lines cross the grid, so you can read the x and y value of any point.',
    img: '/images/previews/coordinate-plane.png',
    alt: 'a grid with a labeled x-axis and y-axis crossing at the origin',
    task: 'Plot a function or equation and see exactly where it crosses each axis, instead of estimating the position from an unlabeled grid.',
    who: 'Students graphing lines and curves, and math teachers who build worksheets.',
  },
  {
    mode: 'Numbered graph paper',
    desc: 'every grid line carries its number along the edge of the sheet.',
    img: '/images/previews/number-grid.png',
    alt: 'numbers running along the top and left edges of the grid',
    task: 'Mark a point at an exact coordinate pair and check the answer against the numbers already printed on the grid.',
    who: 'Students learning to plot coordinates, and parents checking the homework.',
  },
  {
    mode: 'Four quadrant graph paper',
    desc: 'the origin sits in the middle of the sheet, so negative and positive values share one grid.',
    img: '/images/previews/coordinate-plane.png',
    alt: 'all four quadrants with the origin placed in the center',
    task: 'Plot points and shapes that cross into negative x or y values, which a single-quadrant grid cannot show at all.',
    who: 'Middle and high school students in algebra and pre-algebra, and their teachers.',
  },
];

---

<Base title={title} description={description}>
  <script type="application/ld+json" is:inline slot="jsonld" set:html={JSON.stringify(jsonLd)}></script>

  <main>
    <section class="hero">
      <span class="kicker">Free · No signup · No watermark</span>
      <h1>Online Graph Paper Generator</h1>
      <p class="lead">
        Draw online graph paper directly in your browser, then export the exact sheet you drew. Sketch
        on the grid, set the line spacing, add axes and numbers, and download the result as a
        print-ready PDF, PNG, or SVG. There is nothing to install, and no login or watermark.
      </p>
      <div class="hero-ctas">
        <a class="btn" href="#tool">Start drawing</a>
        <a class="btn-outline" href="/printable-graph-paper/">Browse paper types</a>
      </div>
    </section>

    <section class="tool" id="tool" aria-label="Online graph paper canvas">
      <div class="controls">
        <label>
          Size
          <select id="size"></select>
        </label>
        <label>
          Spacing
          <select id="spacing"></select>
        </label>
        <label>
          Orientation
          <select id="orient"></select>
        </label>
        <button type="button" id="clear">Clear</button>
      </div>

      <svg id="grid" viewBox="0 0 210 297" preserveAspectRatio="xMidYMid meet" aria-label="Drawable graph paper grid">
        <g id="grid-lines"></g>
        <g id="strokes"></g>
      </svg>

      <div class="controls" style="margin-top:.75rem">
        <a id="dl-pdf" class="btn" href="/downloads/square-grid/a4-portrait-5mm.pdf" download>Download PDF</a>
        <a id="dl-png" class="btn-outline" href="/images/square-grid/a4-portrait-5mm.png" download>Download PNG</a>
        <a id="dl-svg" class="btn-outline" href="/downloads/square-grid/a4-portrait-5mm.svg" download>Download SVG</a>
      </div>
      <p style="font-size:.9rem;margin:.4rem 0 0">Use this graph paper maker to sketch on the grid above, then export the result.</p>
    </section>

    <section aria-label="Graph paper with axes, numbers, and four quadrants">
      <span class="kicker">Capabilities</span>
      <h2>Graph Paper with Axes, Numbers, and Four Quadrants</h2>
      <p>
        Blank grids are everywhere. What most graph paper tools skip is the coordinate layer — axes,
        numbered lines, and four quadrants. These three modes of online graph paper turn a plain grid
        into something you can plot on, with the origin and the numbers already marked.
      </p>
      <table style="width:100%;border-collapse:collapse;margin-top:1rem">
        <thead>
          <tr style="text-align:left;border-bottom:2px solid var(--border)">
            <th style="padding:.5rem">Mode</th>
            <th style="padding:.5rem">What it solves</th>
            <th style="padding:.5rem">Who searches</th>
          </tr>
        </thead>
        <tbody>
          {axesModes.map((m) => (
            <tr style="border-bottom:1px solid var(--border);vertical-align:top">
              <td style="padding:.6rem;min-width:210px">
                <img src={m.img} alt={m.alt} loading="lazy" style="width:120px;display:block;border:1px solid var(--border);border-radius:6px;margin-bottom:.4rem" />
                <strong>{m.mode}</strong> — {m.desc}
              </td>
              <td style="padding:.6rem;color:var(--muted)">{m.task}</td>
              <td style="padding:.6rem;color:var(--muted)">{m.who}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>
        These three modes of online graph paper share one graph paper tool, so the paper size, spacing, and
        export format stay the same whether you need axes, numbers, or all four quadrants. Pick a
        mode, set the size and spacing, then download the finished sheet as a PDF, PNG, or SVG.
      </p>
    </section>

    <section aria-label="Will the grid print at the exact size">
      <span class="kicker">True size</span>
      <h2>Will the Grid Print at the Exact Size?</h2>
      <p>Online graph paper only prints at its true size if the print dialog is set to do it.</p>
      <p>
        In the print dialog, set the scale to <strong>Actual size</strong> or <strong>100%</strong>.
        If the dialog shows a page-scaling option, set it to <strong>None</strong>, and turn off
        <strong>Fit to page</strong> or <strong>Shrink to fit</strong>. These two choices decide
        whether the grid prints at the size you set or at a size the printer picked.
      </p>
      <p>
        With <strong>Actual size</strong> selected, a 5 mm square prints at 5 mm on paper. Line to
        line, the printed spacing matches a ruler, so the sheet keeps the size you chose.
      </p>
      <p>
        With <strong>Fit to page</strong> selected, the same square comes out smaller. A 5 mm grid
        drops to about 4.6 mm, because the browser squeezes the whole sheet to clear the printer
        margins. Every square shrinks by the same ratio, so the grid still looks even, but it no
        longer matches the number you set.
      </p>
      <p>Before you print a batch, print one test page and measure a single square with a ruler.</p>
    </section>

    <section aria-label="How to use the online graph paper">
      <span class="kicker">Process</span>
      <h2>How to Use the Online Graph Paper</h2>
      <p>Three steps carry a blank grid to a sheet of online graph paper.</p>
      <ol>
        <li><strong>Choose a paper size</strong> from the list. The grid redraws at the size you picked, so what you see is what will print.</li>
        <li><strong>Set the spacing</strong> between grid lines, then switch the axis and numbers on or off. Each change appears in the preview right away.</li>
        <li><strong>Export</strong> the finished sheet as a PDF, PNG, or SVG, then print it or save it to your device.</li>
      </ol>
    </section>

    <section id="paper-types" aria-label="Paper type catalog">
      <span class="kicker">Catalog</span>
      <h2>Paper Types</h2>
      <p>
        Every type of online graph paper lives here in four groups — math, music, drawing, and
        writing — so you can jump to the grid your task needs instead of scrolling one long list.
        Each card opens in the same graph paper tool, ready to draw on.
      </p>
      {paperGroups.map((g) => {
        const all = paperCatalog.filter((e) => e.cat === g.key);
        const shown = g.show.map((id) => all.find((e) => e.id === id)!);
        return (
          <div style="margin-top:2rem">
            <h3>{g.title}</h3>
            <div class="cards">
              {shown.map((e) => (
                <a class="card" href={e.href}>
                  <img class="thumb" src={`/images/previews/${e.id}.png`} alt={`${e.name} preview`} loading="lazy" />
                  <h3>{e.name}</h3>
                  <p>{e.desc}</p>
                </a>
              ))}
            </div>
            <p><a href={`/${g.slug}/`}>View all {all.length} {g.title} templates →</a></p>
          </div>
        );
      })}
      <p>Every entry opens in the same graph paper tool, where you can change the size, spacing, and color before you download.</p>
    </section>

    <section aria-label="Match the grid to the task">
      <span class="kicker">Choose by use</span>
      <h2>Match the Grid to the Task</h2>
      <p>Start from the task in front of you, and the right online graph paper is already here.</p>
      <div class="cards">
        <div class="card">
          <h3>Plot a function</h3>
          <p>Square or coordinate-plane paper gives you labeled axes, so each point lands where the x and y numbers say it should.</p>
          <a href="/coordinate-plane/">Open template →</a>
        </div>
        <div class="card">
          <h3>Take notes</h3>
          <p>A dot grid or ruled lines adds structure that stays light under handwriting and does not fight the pen.</p>
          <a href="/dot-grid/">Open template →</a>
        </div>
        <div class="card">
          <h3>Draw an isometric sketch</h3>
          <p>A 30° grid keeps every edge on one of the three visible faces, so the depth stays believable.</p>
          <a href="/isometric-grid/">Open template →</a>
        </div>
        <div class="card">
          <h3>Plot science data</h3>
          <p>Polar or semi-log axes fit the numbers when they follow an angle or a growth curve instead of a straight line.</p>
          <a href="/semi-log/">Open template →</a>
        </div>
      </div>
      <p>Each task opens the matching grid, ready to resize, print, or export.</p>
    </section>

    <section aria-label="What this tool cannot do">
      <span class="kicker">Limits</span>
      <h2>What This Graph Paper Tool Can't Do</h2>
      <p>Three limits are worth knowing before you rely on the graph paper tool.</p>
      <ol>
        <li>The canvas does not save itself. Close the tab or reload the page, and anything you drew but did not export is gone. Export the file before you leave if the sketch matters.</li>
        <li>The graph paper tool cannot read a photo. Point your camera at a printed sheet and it will not come back as an editable grid, so keep the exported file if you plan to edit it again.</li>
        <li>The graph paper tool cannot guarantee printer margins. Each printer and driver decides its own printable area, so the grid may sit a few millimeters from the paper edge, or closer than the preview shows.</li>
      </ol>
    </section>

    <span class="kicker">Questions</span>
    <h2 id="faq">Frequently Asked Questions</h2>
    <p>Answers to common questions about the online graph paper generator: what it is, downloading, printing at the right size, square sizes, and whether it is free.</p>
    {faq.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}

    <p>
      If you already know which sheet you need, go straight to it: browse the full set of
      <a href="/printable-graph-paper/">printable graph paper</a> templates, open a
      <a href="/coordinate-plane/">coordinate plane</a> for plotting, or start an
      <a href="/isometric-grid/">isometric grid</a> for 3D sketches. Each one loads in the same
      graph paper tool, so the size, spacing, and export controls stay the same.
    </p>

    <footer>
      <p>All generated PDF files are free for personal, educational and commercial use.</p>
      <div class="cols">
        <div>
          <h2>Tools</h2>
          <ul>
            <li><a href="/printable-graph-paper/">Printable Graph Paper</a></li>
            <li><a href="/square-grid/">Square Grid</a></li>
            <li><a href="/isometric-grid/">Isometric Grid</a></li>
            <li><a href="/semi-log/">Semi-Log Graph Paper</a></li>
            <li><a href="/">Online Graph Paper Generator</a></li>
          </ul>
        </div>
        <div>
          <h2>Resources</h2>
          <ul>
            <li><a href="#paper-types">Paper type catalog</a></li>
            <li><a href="/printable-graph-paper/">Printable graph paper PDF</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </div>
      </div>
      <p><a href="/">Home</a> · <a href="/privacy/">Privacy Policy</a> · <a href="/sitemap.xml">Sitemap</a> · © 2026 onlinegraphpaper.org</p>
    </footer>
  </main>

  <script>
    import { sizes } from '../data/sizes';
    import { spacings } from '../data/spacings';
    import { defaultGridColor } from '../data/gridColors';

    const sizeSel = document.getElementById('size') as HTMLSelectElement;
    const spacingSel = document.getElementById('spacing') as HTMLSelectElement;
    const orientSel = document.getElementById('orient') as HTMLSelectElement;
    const svg = document.getElementById('grid') as SVGSVGElement;
    const gridG = document.getElementById('grid-lines') as SVGGElement;
    const strokeG = document.getElementById('strokes') as SVGGElement;
    const dlPdf = document.getElementById('dl-pdf') as HTMLAnchorElement;
    const dlPng = document.getElementById('dl-png') as HTMLAnchorElement;
    const dlSvg = document.getElementById('dl-svg') as HTMLAnchorElement;

    const NS = 'http://www.w3.org/2000/svg';

    // Populate the selects (sizes/spacings/orientations) once.
    sizeSel.innerHTML = sizes.map((s) => `<option value="${s.id}">${s.name} — ${s.widthMm} × ${s.heightMm} mm</option>`).join('');
    spacingSel.innerHTML = spacings.map((sp) => `<option value="${sp.id}">${sp.id} (${sp.mm} mm)</option>`).join('');
    orientSel.innerHTML = ['portrait', 'landscape'].map((o) => `<option value="${o}">${o}</option>`).join('');

    function current() {
      const size = sizes.find((s) => s.id === sizeSel.value)!;
      const spacing = spacings.find((sp) => sp.id === spacingSel.value)!;
      return { size, spacing, orient: orientSel.value };
    }

    function render() {
      const { size, spacing, orient } = current();
      const w = orient === 'landscape' ? size.heightMm : size.widthMm;
      const h = orient === 'landscape' ? size.widthMm : size.heightMm;
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      let lines = '';
      for (let x = 0; x <= w + 1e-6; x += spacing.mm) {
        lines += `<line x1="${x.toFixed(3)}" y1="0" x2="${x.toFixed(3)}" y2="${h.toFixed(3)}" stroke="${defaultGridColor.hex}" stroke-width="0.2"/>`;
      }
      for (let y = 0; y <= h + 1e-6; y += spacing.mm) {
        lines += `<line x1="0" y1="${y.toFixed(3)}" x2="${w.toFixed(3)}" y2="${y.toFixed(3)}" stroke="${defaultGridColor.hex}" stroke-width="0.2"/>`;
      }
      gridG.innerHTML = lines;
      const base = `${size.id}-${orient}-${spacing.id}`;
      dlPdf.href = `/downloads/square-grid/${base}.pdf`;
      dlPng.href = `/images/square-grid/${base}.png`;
      dlSvg.href = `/downloads/square-grid/${base}.svg`;
    }

    let drawing = false;
    let path: SVGPolylineElement | null = null;

    function toPoint(e: PointerEvent) {
      const pt = svg.createSVGPoint();
      pt.x = e.clientX;
      pt.y = e.clientY;
      const ctm = svg.getScreenCTM();
      if (!ctm) return pt;
      return pt.matrixTransform(ctm.inverse());
    }

    svg.addEventListener('pointerdown', (e) => {
      drawing = true;
      svg.setPointerCapture(e.pointerId);
      path = document.createElementNS(NS, 'polyline');
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', '#111827');
      path.setAttribute('stroke-width', '0.6');
      const p = toPoint(e);
      path.setAttribute('points', `${p.x.toFixed(2)},${p.y.toFixed(2)}`);
      strokeG.appendChild(path);
    });
    svg.addEventListener('pointermove', (e) => {
      if (!drawing || !path) return;
      const p = toPoint(e);
      path.setAttribute('points', `${path.getAttribute('points')} ${p.x.toFixed(2)},${p.y.toFixed(2)}`);
    });
    svg.addEventListener('pointerup', () => { drawing = false; path = null; });
    svg.addEventListener('pointercancel', () => { drawing = false; path = null; });

    document.getElementById('clear')!.addEventListener('click', () => { strokeG.innerHTML = ''; });

    sizeSel.addEventListener('change', render);
    spacingSel.addEventListener('change', render);
    orientSel.addEventListener('change', render);

    render();
  </script>
</Base>
